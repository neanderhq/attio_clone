{
  "name": "neander-nextjs-starter",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@11.18.0",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build && node .neander/prepare-standalone.mjs",
    "start": "node .next/standalone/server.js",
    "check": "tsc --noEmit",
    "seed": "node --env-file=.env.local scripts/seed.mjs",
    "build:worker": "opennextjs-cloudflare build",
    "preview:worker": "wrangler dev",
    "deploy:worker": "opennextjs-cloudflare build && wrangler deploy",
    "test:worker": "node tests/worker-smoke.mjs"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.2.0",
    "@next/env": "16.3.4",
    "drizzle-orm": "0.45.2",
    "next": "16.3.4",
    "pg": "8.23.0",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "^1.20.16",
    "@types/node": "24.13.3",
    "@types/pg": "8.23.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "drizzle-kit": "0.31.10",
    "tsx": "4.20.6",
    "typescript": "7.0.2",
    "wrangler": "^4.158.0"
  }
}
